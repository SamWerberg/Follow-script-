--==================================================
-- CONNECTION CLEANUP
--==================================================

local function disconnect(name)
	if connections[name] then
		connections[name]:Disconnect()
		connections[name] = nil
	end
end

local function disconnectAllTargetConnections()

	disconnect("TargetCharacterAdded")
	disconnect("TargetHumanoidState")
	disconnect("TargetDied")
	disconnect("TargetChildAdded")
	disconnect("TargetChildRemoved")

	targetCharacter = nil
	targetHumanoid = nil
	targetRoot = nil
end

