--==================================================
-- FIND PLAYER
--==================================================

local function findPlayer(searchText)

	searchText = string.lower(
		string.gsub(searchText, "^%s*(.-)%s*$", "%1")
	)

	if searchText == "" then
		return nil
	end

	-- Exact username
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == searchText then
			return p
		end
	end

	-- Exact display name
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.DisplayName) == searchText then
			return p
		end
	end

	-- Partial username
	for _, p in ipairs(Players:GetPlayers()) do
		if string.find(
			string.lower(p.Name),
			searchText,
			1,
			true
		) then
			return p
		end
	end

	-- Partial display name
	for _, p in ipairs(Players:GetPlayers()) do
		if string.find(
			string.lower(p.DisplayName),
			searchText,
			1,
			true
		) then
			return p
		end
	end

	return nil
end

--==================================================
-- OUR CHARACTER VALIDATION
--==================================================

local function isOurCharacterAlive()

	if not character then
		return false
	end

	if not humanoid then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if character.Parent == nil then
		return false
	end

	return true
end

--==================================================
-- TARGET VALIDATION
--==================================================

local function updateTargetReferences()

	if not targetPlayer then
		targetCharacter = nil
		targetHumanoid = nil
		targetRoot = nil
		return false
	end

	targetCharacter = targetPlayer.Character

	if not targetCharacter then
		targetHumanoid = nil
		targetRoot = nil
		return false
	end

	targetHumanoid =
		targetCharacter:FindFirstChildOfClass("Humanoid")

	targetRoot =
		targetCharacter:FindFirstChild("HumanoidRootPart")

	if not targetHumanoid or not targetRoot then
		return false
	end

	if targetHumanoid.Health <= 0 then
		return false
	end

	return true
end

--==================================================
-- UNEQUIP OUR TOOL
--==================================================

local function unequipOurTool()

	if not isOurCharacterAlive() then
		return
	end

	humanoid:UnequipTools()
end

--==================================================
-- EQUIP MATCHING TOOL
--==================================================

local function equipMatchingTool(toolName)

	if not isOurCharacterAlive() then
		return
	end

	if not toolName or toolName == "" then
		return
	end

	local currentTool =
		character:FindFirstChildOfClass("Tool")

	if currentTool and currentTool.Name == toolName then
		return
	end

	local backpack =
		player:FindFirstChildOfClass("Backpack")

	if not backpack then
		return
	end

	local matchingTool =
		backpack:FindFirstChild(toolName)

	if matchingTool and matchingTool:IsA("Tool") then
		humanoid:EquipTool(matchingTool)
	end
end

--==================================================
-- SYNC TARGET TOOL
--==================================================

local function syncTargetTool()

	if not following then
		return
	end

	if not updateTargetReferences() then
		return
	end

	local targetTool =
		targetCharacter:FindFirstChildOfClass("Tool")

	if targetTool then
		equipMatchingTool(targetTool.Name)
	else
		unequipOurTool()
	end
end

--==================================================
-- CONNECT TARGET TOOL EVENTS
--==================================================

local function connectTargetToolEvents()

	if not targetCharacter then
		return
	end

	disconnect("TargetChildAdded")
	disconnect("TargetChildRemoved")

	-- Target equips a tool
	connections.TargetChildAdded =
		targetCharacter.ChildAdded:Connect(function(child)

			if not following then
				return
			end

			if child:IsA("Tool") then
				task.defer(function()

					if following and
						isOurCharacterAlive() then

						equipMatchingTool(child.Name)
					end
				end)
			end
		end)

	-- Target removes a tool
	connections.TargetChildRemoved =
		targetCharacter.ChildRemoved:Connect(function(child)

			if not following then
				return
			end

			if not child:IsA("Tool") then
				return
			end

			task.defer(function()

				if not following then
					return
				end

				if not updateTargetReferences() then
					return
				end

				local replacement =
					targetCharacter:FindFirstChildOfClass("Tool")

				if replacement then
					equipMatchingTool(replacement.Name)
				else
					unequipOurTool()
				end
			end)
		end)

	syncTargetTool()
end

--==================================================
-- TARGET JUMP DETECTION
--==================================================

local function tryMirrorTargetJump()

	if not following then
		return
	end

	if followLocked then
		return
	end

	if targetJumpCooldown then
		return
	end

	if not isOurCharacterAlive() then
		return
	end

	if not updateTargetReferences() then
		return
	end

	-- Don't jump if we're already airborne.
	local floorMaterial = humanoid.FloorMaterial

	if floorMaterial == Enum.Material.Air then
		return
	end

	-- Target must actually be moving upward.
	local targetVelocity =
		targetRoot.AssemblyLinearVelocity

	if targetVelocity.Y < 1 then
		return
	end

	-- Prevent multiple jumps from one target jump.
	targetJumpCooldown = true

	humanoid.Jump = true

	-- Let the target jump finish before another
	-- target jump can be mirrored.
	task.delay(0.35, function()
		targetJumpCooldown = false
	end)
end

--==================================================
-- TARGET CONNECTIONS
--==================================================

local function connectTarget()

	disconnectAllTargetConnections()

	if not targetPlayer then
		return
	end

	updateTargetReferences()

	if not targetCharacter then
		return
	end

	--==================================================
	-- TARGET JUMP / STATE MONITOR
	--==================================================

	connections.TargetHumanoidState =
		targetHumanoid.StateChanged:Connect(
			function(_, newState)

				if not following then
					return
				end

				-- Jumping state catches normal jumps.
				if newState ==
					Enum.HumanoidStateType.Jumping then

					tryMirrorTargetJump()

					return
				end

				-- Freefall with upward velocity catches
				-- jumps that transition too quickly.
				if newState ==
					Enum.HumanoidStateType.Freefall then

					tryMirrorTargetJump()
				end
			end
		)

	--==================================================
	-- TARGET DEATH
	--==================================================

	connections.TargetDied =
		targetHumanoid.Died:Connect(function()

			if not following then
				return
			end

			following = false
			targetJumpCooldown = false

			disconnectAllTargetConnections()

			followButton.Text = "FOLLOW"
			followButton.BackgroundColor3 =
				Color3.fromRGB(0, 170, 90)

			setStatus(
				"Target died. Following stopped.",
				Color3.fromRGB(255, 180, 80)
			)
		end)

	--==================================================
	-- TARGET RESPAWN
	--==================================================

	connections.TargetCharacterAdded =
		targetPlayer.CharacterAdded:Connect(function(newCharacter)

			if not following then
				return
			end

			-- Wait for the new character to be ready.
			local newHumanoid =
				newCharacter:WaitForChild(
					"Humanoid",
					5
				)

			local newRoot =
				newCharacter:WaitForChild(
					"HumanoidRootPart",
					5
				)

			if not newHumanoid or not newRoot then
				return
			end

			if not following then
				return
			end

			targetCharacter = newCharacter
			targetHumanoid = newHumanoid
			targetRoot = newRoot

			connectTarget()
		end)

	connectTargetToolEvents()
end

--==================================================
-- FOLLOW MOVEMENT
--==================================================

local lastMovePosition = nil

local function updateFollowMovement()

	if not following then
		return
	end

	if followLocked then
		return
	end

	if not isOurCharacterAlive() then
		return
	end

	if not updateTargetReferences() then
		return
	end

	-- Don't move toward a dead target.
	if targetHumanoid.Health <= 0 then
		return
	end

	-- Keep a little distance behind the target.
	local desiredPosition =
		targetRoot.Position
		- targetRoot.CFrame.LookVector * 4

	-- Don't constantly send identical MoveTo calls.
	if lastMovePosition then

		local difference =
			(desiredPosition - lastMovePosition).Magnitude

		if difference < 0.15 then
			return
		end
	end

	lastMovePosition = desiredPosition

	humanoid:MoveTo(desiredPosition)
end

--==================================================
-- FOLLOW HEARTBEAT
--==================================================

connections.FollowHeartbeat =
	RunService.Heartbeat:Connect(function()

		if not following then
			return
		end

		-- Completely stop if our character is dead.
		if not isOurCharacterAlive() then
			return
		end

		updateFollowMovement()
	end)

--==================================================
-- FOLLOW BUTTON
--==================================================

followButton.Activated:Connect(function()

	-- Locked after death
	if followLocked then

		setStatus(
			"Locked. " ..
			(targetPlayer and
				targetPlayer.Name or
				"Target") ..
			" must touch you.",
			Color3.fromRGB(255, 180, 70)
		)

		return
	end

	-- Stop following
	if following then

		following = false
		lastMovePosition = nil
		targetJumpCooldown = false

		disconnectAllTargetConnections()

		followButton.Text = "FOLLOW"
		followButton.BackgroundColor3 =
			Color3.fromRGB(0, 170, 90)

		setStatus(
			"Not following",
			Color3.fromRGB(220, 220, 220)
		)

		return
	end

	-- Find target
	local foundPlayer =
		findPlayer(usernameBox.Text)

	if not foundPlayer then

		setStatus(
			"Player not found. Try part of their username.",
			Color3.fromRGB(255, 100, 100)
		)

		return
	end

	if foundPlayer == player then

		setStatus(
			"You cannot follow yourself.",
			Color3.fromRGB(255, 100, 100)
		)

		return
	end

	targetPlayer = foundPlayer
	following = true
	lastMovePosition = nil
	targetJumpCooldown = false

	followButton.Text = "STOP"
	followButton.BackgroundColor3 =
		Color3.fromRGB(200, 60, 60)

	setStatus(
		"Following " ..
		targetPlayer.DisplayName ..
		" (@" ..
		targetPlayer.Name ..
		")",
		Color3.fromRGB(100, 255, 150)
	)

	connectTarget()
end)

--==================================================
-- MANUAL JUMP
--==================================================

jumpButton.Activated:Connect(function()

	if not isOurCharacterAlive() then
		return
	end

	if not canManualJump then
		return
	end

	-- Must actually be standing on something.
	if humanoid.FloorMaterial ==
		Enum.Material.Air then
		return
	end

	canManualJump = false

	jumpButton.Text = "WAIT..."
	jumpButton.BackgroundColor3 =
		Color3.fromRGB(90, 90, 90)

	humanoid.Jump = true
end)

--==================================================
-- CHARACTER SETUP
--==================================================

local function setupCharacter(newCharacter)

	character = newCharacter

	humanoid =
		newCharacter:WaitForChild("Humanoid")

	rootPart =
		newCharacter:WaitForChild("HumanoidRootPart")

	canManualJump = true
	targetJumpCooldown = false
	lastMovePosition = nil

	jumpButton.Text = "JUMP"
	jumpButton.BackgroundColor3 =
		Color3.fromRGB(0, 140, 255)

	--==================================================
	-- AFTER DEATH LOCK
	--==================================================

	if followLocked then

		following = false

		followButton.Text = "LOCKED"
		followButton.BackgroundColor3 =
			Color3.fromRGB(120, 80, 30)

		setStatus(
			"Locked. " ..
			(targetPlayer and
				targetPlayer.Name or
				"Target") ..
			" must touch you.",
			Color3.fromRGB(255, 190, 80)
		)
	end

	--==================================================
	-- LANDING DETECTION
	--==================================================

	connections.OurState =
		humanoid.StateChanged:Connect(
			function(_, newState)

				if newState ==
					Enum.HumanoidStateType.Landed then

					canManualJump = true

					jumpButton.Text = "JUMP"
					jumpButton.BackgroundColor3 =
						Color3.fromRGB(0, 140, 255)
				end
			end
		)

	--==================================================
	-- OUR DEATH
	--==================================================

	connections.OurDeath =
		humanoid.Died:Connect(function()

			-- FIRST:
			-- Stop every action that could continue
			-- controlling the old character.
			following = false
			targetJumpCooldown = false
			lastMovePosition = nil

			disconnectAllTargetConnections()

			-- Lock following until target touches us
			-- after respawn.
			followLocked = true

			followButton.Text = "LOCKED"
			followButton.BackgroundColor3 =
				Color3.fromRGB(120, 80, 30)

			setStatus(
				"Dead. After respawning, " ..
				(targetPlayer and
					targetPlayer.Name or
					"the target") ..
				" must touch you.",
				Color3.fromRGB(255, 100, 100)
			)
		end)

	--==================================================
	-- TOUCH UNLOCK
	--==================================================

	for _, part in ipairs(
		newCharacter:GetDescendants()
	) do

		if part:IsA("BasePart") then

			part.Touched:Connect(function(hit)

				if not followLocked then
					return
				end

				if not targetPlayer then
					return
				end

				local currentTargetCharacter =
					targetPlayer.Character

				if not currentTargetCharacter then
					return
				end

				local touchedModel =
					hit:FindFirstAncestorOfClass(
						"Model"
					)

				if touchedModel ==
					currentTargetCharacter then

					-- Unlock
					followLocked = false
					following = true

					lastMovePosition = nil
					targetJumpCooldown = false

					followButton.Text = "STOP"
					followButton.BackgroundColor3 =
						Color3.fromRGB(200, 60, 60)

					setStatus(
						"Unlocked! Following " ..
						targetPlayer.DisplayName,
						Color3.fromRGB(100, 255, 150)
					)

					connectTarget()
				end
			end)
		end
	end
end

--==================================================
-- CHARACTER EVENTS
--==================================================

if player.Character then
	setupCharacter(player.Character)
end

player.CharacterAdded:Connect(function(newCharacter)

	-- The old character is gone.
	-- Set up the new one cleanly.
	setupCharacter(newCharacter)

	-- If we are locked, don't automatically follow.
	if followLocked then
		following = false
	end
end)

--==================================================
-- DRAGGING
--==================================================

local dragging = false
local dragStart = nil
local startPosition = nil

title.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = frame.Position
	end
end)

title.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if not dragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		local delta =
			input.Position - dragStart

		frame.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,

			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)
