--==================================================
-- CONNECTION MANAGEMENT
--==================================================

local function disconnect(name)
	if connections[name] then
		connections[name]:Disconnect()
		connections[name] = nil
	end
end

local function disconnectTarget()
	disconnect("TargetCharacter")
	disconnect("TargetState")
	disconnect("TargetDied")
	disconnect("TargetAdded")
	disconnect("TargetRemoved")

	targetCharacter = nil
	targetHumanoid = nil
	targetRoot = nil

	targetJumping = false
	targetJumpDebounce = false
end

