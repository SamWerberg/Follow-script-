--==================================================
-- STATUS FUNCTION
--==================================================

local function setStatus(text, color)

	statusLabel.Text = "Status: " .. text

	if color then
		statusLabel.TextColor3 = color
	else
		statusLabel.TextColor3 =
			Color3.fromRGB(220, 220, 220)
	end
end

--==================================================
-- FIND PLAYER
--==================================================

local function findPlayer(searchText)

	searchText = string.lower(searchText)

	if searchText == "" then
		return nil
	end

	-- Exact username
	for _, p in ipairs(Players:GetPlayers()) do

		if string.lower(p.Name) == searchText then
			return p
		end
	end

	-- Exact display name
	for _, p in ipairs(Players:GetPlayers()) do

		if string.lower(p.DisplayName) == searchText then
			return p
		end
	end

	-- Partial username
	for _, p in ipairs(Players:GetPlayers()) do

		if string.find(
			string.lower(p.Name),
			searchText,
			1,
			true
		) then

			return p
		end
	end

	-- Partial display name
	for _, p in ipairs(Players:GetPlayers()) do

		if string.find(
			string.lower(p.DisplayName),
			searchText,
			1,
			true
		) then

			return p
		end
	end

	return nil
end

--==================================================
-- DISCONNECT TARGET CONNECTIONS
--==================================================

local function disconnectTargetConnections()

	if targetJumpConnection then
		targetJumpConnection:Disconnect()
		targetJumpConnection = nil
	end

	if targetCharacterConnection then
		targetCharacterConnection:Disconnect()
		targetCharacterConnection = nil
	end

	if targetDeathConnection then
		targetDeathConnection:Disconnect()
		targetDeathConnection = nil
	end

	if targetToolConnection then
		targetToolConnection:Disconnect()
		targetToolConnection = nil
	end

	if targetToolRemovedConnection then
		targetToolRemovedConnection:Disconnect()
		targetToolRemovedConnection = nil
	end

	targetHumanoid = nil
end

--==================================================
-- UNEQUIP OUR TOOL
--==================================================

local function unequipOurTool()

	if not humanoid then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	humanoid:UnequipTools()
end

--==================================================
-- EQUIP SAME TOOL
--==================================================

local function equipTargetTool(toolName)

	if not humanoid then
		return
	end

	if not character then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	if not toolName or toolName == "" then
		return
	end

	-- Check currently equipped tool
	local currentTool =
		character:FindFirstChildOfClass("Tool")

	if currentTool and currentTool.Name == toolName then
		return
	end

	local backpack =
		player:FindFirstChildOfClass("Backpack")

	if not backpack then
		return
	end

	local matchingTool =
		backpack:FindFirstChild(toolName)

	if matchingTool and matchingTool:IsA("Tool") then

		humanoid:EquipTool(matchingTool)
	end
end

--==================================================
-- CHECK TARGET'S CURRENT TOOL
--==================================================

local function checkTargetTool()

	if not following then
		return
	end

	if not targetPlayer then
		return
	end

	local targetCharacter =
		targetPlayer.Character

	if not targetCharacter then
		return
	end

	local tool =
		targetCharacter:FindFirstChildOfClass("Tool")

	if tool then

		equipTargetTool(tool.Name)

	else

		unequipOurTool()
	end
end

--==================================================
-- CONNECT TOOL DETECTION
--==================================================

local function connectTargetToolDetection()

	if not targetPlayer then
		return
	end

	local targetCharacter =
		targetPlayer.Character

	if not targetCharacter then
		return
	end

	if targetToolConnection then
		targetToolConnection:Disconnect()
		targetToolConnection = nil
	end

	if targetToolRemovedConnection then
		targetToolRemovedConnection:Disconnect()
		targetToolRemovedConnection = nil
	end

	-- Tool equipped
	targetToolConnection =
		targetCharacter.ChildAdded:Connect(function(child)

			if not following then
				return
			end

			if child:IsA("Tool") then

				task.wait()

				if following then
					equipTargetTool(child.Name)
				end
			end
		end)

	-- Tool unequipped
	targetToolRemovedConnection =
		targetCharacter.ChildRemoved:Connect(function(child)

			if not following then
				return
			end

			if not child:IsA("Tool") then
				return
			end

			task.wait()

			if not following then
				return
			end

			local newTool =
				targetCharacter:FindFirstChildOfClass("Tool")

			if newTool then

				equipTargetTool(newTool.Name)

			else

				unequipOurTool()
			end
		end)

	checkTargetTool()
end

--==================================================
-- TARGET JUMP SYNC
--==================================================

local function connectTargetJump(targetCharacter)

	if not following then
		return
	end

	if not targetCharacter then
		return
	end

	local targetHumanoid =
		targetCharacter:FindFirstChildOfClass("Humanoid")

	if not targetHumanoid then
		return
	end

	targetHumanoid = targetHumanoid

	-- Remove old jump connection
	if targetJumpConnection then
		targetJumpConnection:Disconnect()
		targetJumpConnection = nil
	end

	-- IMPORTANT:
	-- Humanoid.Jumping is more reliable than StateChanged
	-- for detecting jumps while the target is moving.
	targetJumpConnection =
		targetHumanoid.Jumping:Connect(function(isJumping)

			if not isJumping then
				return
			end

			if not following then
				return
			end

			if followLocked then
				return
			end

			if not humanoid then
				return
			end

			if humanoid.Health <= 0 then
				return
			end

			-- Only jump if WE are actually grounded.
			-- This prevents repeated/air jumps.
			if humanoid.FloorMaterial ==
				Enum.Material.Air then

				return
			end

			-- Mirror the target's jump.
			humanoid.Jump = true

			humanoid:ChangeState(
				Enum.HumanoidStateType.Jumping
			)
		end)

	-- Target death detection
	if targetDeathConnection then
		targetDeathConnection:Disconnect()
		targetDeathConnection = nil
	end

	targetDeathConnection =
		targetHumanoid.Died:Connect(function()

			if not following then
				return
			end

			-- Stop following the dead target.
			following = false

			-- Disconnect all target listeners.
			disconnectTargetConnections()

			followButton.Text = "FOLLOW"
			followButton.BackgroundColor3 =
				Color3.fromRGB(0, 170, 90)

			setStatus(
				"Target died. Following stopped.",
				Color3.fromRGB(255, 180, 80)
			)
		end)
end

--==================================================
-- CONNECT TO TARGET
--==================================================

local function connectToTarget()

	disconnectTargetConnections()

	if not targetPlayer then
		return
	end

	-- Detect target respawning
	targetCharacterConnection =
		targetPlayer.CharacterAdded:Connect(function(newCharacter)

			if not following then
				return
			end

			local newHumanoid =
				newCharacter:WaitForChild(
					"Humanoid",
					5
				)

			if not newHumanoid then
				return
			end

			if not following then
				return
			end

			connectTargetJump(newCharacter)
			connectTargetToolDetection()
		end)

	-- Current target character
	local targetCharacter =
		targetPlayer.Character

	if targetCharacter then

		connectTargetJump(targetCharacter)

		connectTargetToolDetection()
	end
end

--==================================================
-- FOLLOW TARGET
--==================================================

RunService.Heartbeat:Connect(function()

	if not following then
		return
	end

	if followLocked then
		return
	end

	if not targetPlayer then
		return
	end

	if not humanoid then
		return
	end

	-- IMPORTANT:
	-- Never issue movement commands to a dead
	-- humanoid. This prevents follow logic from
	-- continuing after YOUR character dies.
	if humanoid.Health <= 0 then
		return
	end

	local targetCharacter =
		targetPlayer.Character

	if not targetCharacter then
		return
	end

	local targetHumanoid =
		targetCharacter:FindFirstChildOfClass("Humanoid")

	if not targetHumanoid then
		return
	end

	-- Don't follow a dead target.
	if targetHumanoid.Health <= 0 then
		return
	end

	local targetRoot =
		targetCharacter:FindFirstChild(
			"HumanoidRootPart"
		)

	local myRoot =
		character and
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not targetRoot or not myRoot then
		return
	end

	-- Follow behind the target.
	local targetPosition =
		targetRoot.Position
		- targetRoot.CFrame.LookVector * 4

	humanoid:MoveTo(targetPosition)
end)

--==================================================
-- FOLLOW BUTTON
--==================================================

followButton.Activated:Connect(function()

	if followLocked then

		setStatus(
			"Locked after death. Let " ..
			(targetPlayer and
				targetPlayer.Name or
				"the target") ..
			" touch you.",
			Color3.fromRGB(255, 180, 70)
		)

		return
	end

	-- Stop following
	if following then

		following = false

		disconnectTargetConnections()

		followButton.Text = "FOLLOW"
		followButton.BackgroundColor3 =
			Color3.fromRGB(0, 170, 90)

		setStatus(
			"Not following",
			Color3.fromRGB(220, 220, 220)
		)

		return
	end

	-- Find target
	local foundPlayer =
		findPlayer(usernameBox.Text)

	if not foundPlayer then

		setStatus(
			"Player not found. Try part of their username.",
			Color3.fromRGB(255, 100, 100)
		)

		return
	end

	if foundPlayer == player then

		setStatus(
			"You cannot follow yourself.",
			Color3.fromRGB(255, 100, 100)
		)

		return
	end

	targetPlayer = foundPlayer
	following = true

	followButton.Text = "STOP"
	followButton.BackgroundColor3 =
		Color3.fromRGB(200, 60, 60)

	setStatus(
		"Following " ..
		targetPlayer.DisplayName ..
		" (@" ..
		targetPlayer.Name ..
		")",
		Color3.fromRGB(100, 255, 150)
	)

	connectToTarget()
end)

--==================================================
-- ONE JUMP PER LANDING
--==================================================

jumpButton.Activated:Connect(function()

	if not humanoid then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	if not canJump then
		return
	end

	-- Must be grounded
	if humanoid.FloorMaterial ==
		Enum.Material.Air then

		return
	end

	canJump = false

	jumpButton.Text = "WAIT..."
	jumpButton.BackgroundColor3 =
		Color3.fromRGB(90, 90, 90)

	humanoid.Jump = true

	humanoid:ChangeState(
		Enum.HumanoidStateType.Jumping
	)
end)

--==================================================
-- CHARACTER SETUP
--==================================================

local function setupCharacter(newCharacter)

	character = newCharacter

	humanoid =
		character:WaitForChild("Humanoid")

	canJump = true

	jumpButton.Text = "JUMP"
	jumpButton.BackgroundColor3 =
		Color3.fromRGB(0, 140, 255)

	--==================================================
	-- LOCK AFTER OUR DEATH
	--==================================================

	if followLocked then

		following = false

		followButton.Text = "LOCKED"
		followButton.BackgroundColor3 =
			Color3.fromRGB(120, 80, 30)

		setStatus(
			"Locked. " ..
			(targetPlayer and
				targetPlayer.Name or
				"Target") ..
			" must touch you.",
			Color3.fromRGB(255, 190, 80)
		)
	end

	--==================================================
	-- ONE JUMP PER LANDING
	--==================================================

	humanoid.StateChanged:Connect(
		function(_, newState)

			if newState ==
				Enum.HumanoidStateType.Landed then

				canJump = true

				jumpButton.Text = "JUMP"
				jumpButton.BackgroundColor3 =
					Color3.fromRGB(0, 140, 255)
			end
		end
	)

	--==================================================
	-- OUR DEATH
	--==================================================

	humanoid.Died:Connect(function()

		-- Stop ALL following immediately.
		following = false

		-- Lock until target touches us after respawn.
		followLocked = true

		disconnectTargetConnections()

		followButton.Text = "LOCKED"
		followButton.BackgroundColor3 =
			Color3.fromRGB(120, 80, 30)

		setStatus(
			"Dead. After respawning, " ..
			(targetPlayer and
				targetPlayer.Name or
				"the target") ..
			" must touch you.",
			Color3.fromRGB(255, 100, 100)
		)
	end)

	--==================================================
	-- TOUCH UNLOCK
	--==================================================

	for _, part in ipairs(
		character:GetDescendants()
	) do

		if part:IsA("BasePart") then

			part.Touched:Connect(function(hit)

				if not followLocked then
					return
				end

				if not targetPlayer then
					return
				end

				local targetCharacter =
					targetPlayer.Character

				if not targetCharacter then
					return
				end

				local touchedCharacter =
					hit:FindFirstAncestorOfClass(
						"Model"
					)

				if touchedCharacter ==
					targetCharacter then

					-- Unlock
					followLocked = false
					following = true

					followButton.Text = "STOP"
					followButton.BackgroundColor3 =
						Color3.fromRGB(200, 60, 60)

					setStatus(
						"Unlocked! Following " ..
						targetPlayer.DisplayName,
						Color3.fromRGB(100, 255, 150)
					)

					connectToTarget()
				end
			end)
		end
	end
end

