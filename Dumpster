--==================================================
-- FIND PLAYER
--==================================================

local function findPlayer(search)

	search = string.lower(search or "")

	if search == "" then
		return nil
	end

	-- Exact username
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == search then
			return p
		end
	end

	-- Exact display name
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.DisplayName) == search then
			return p
		end
	end

	-- Partial username
	for _, p in ipairs(Players:GetPlayers()) do
		if string.find(
			string.lower(p.Name),
			search,
			1,
			true
		) then
			return p
		end
	end

	-- Partial display name
	for _, p in ipairs(Players:GetPlayers()) do
		if string.find(
			string.lower(p.DisplayName),
			search,
			1,
			true
		) then
			return p
		end
	end

	return nil
end

--==================================================
-- CHARACTER CHECK
--==================================================

local function alive()

	return character
		and character.Parent
		and humanoid
		and humanoid.Health > 0
		and rootPart
end

--==================================================
-- TARGET REFERENCES
--==================================================

local function updateTarget()

	if not targetPlayer then
		return false
	end

	targetCharacter = targetPlayer.Character

	if not targetCharacter then
		return false
	end

	targetHumanoid =
		targetCharacter:FindFirstChildOfClass("Humanoid")

	targetRoot =
		targetCharacter:FindFirstChild("HumanoidRootPart")

	return targetHumanoid ~= nil
		and targetRoot ~= nil
		and targetHumanoid.Health > 0
end

--==================================================
-- TOOL SYNC
--==================================================

local function unequipTool()

	if not alive() then
		return
	end

	humanoid:UnequipTools()
end

local function equipTool(toolName)

	if not alive() then
		return
	end

	local backpack =
		player:FindFirstChildOfClass("Backpack")

	if not backpack then
		return
	end

	local current =
		character:FindFirstChildOfClass("Tool")

	if current and current.Name == toolName then
		return
	end

	local tool =
		backpack:FindFirstChild(toolName)

	if tool and tool:IsA("Tool") then
		humanoid:EquipTool(tool)
	end
end

local function syncTool()

	if not following then
		return
	end

	if not updateTarget() then
		return
	end

	local targetTool =
		targetCharacter:FindFirstChildOfClass("Tool")

	if targetTool then
		equipTool(targetTool.Name)
	else
		unequipTool()
	end
end

local function connectToolSync()

	if not targetCharacter then
		return
	end

	disconnect("TargetAdded")
	disconnect("TargetRemoved")

	connections.TargetAdded =
		targetCharacter.ChildAdded:Connect(function(child)

			if not following then
				return
			end

			if child:IsA("Tool") then
				task.defer(function()
					if following then
						equipTool(child.Name)
					end
				end)
			end
		end)

	connections.TargetRemoved =
		targetCharacter.ChildRemoved:Connect(function(child)

			if not following then
				return
			end

			if not child:IsA("Tool") then
				return
			end

			task.defer(function()

				if not following then
					return
				end

				if not updateTarget() then
					return
				end

				local newTool =
					targetCharacter:FindFirstChildOfClass("Tool")

				if newTool then
					equipTool(newTool.Name)
				else
					unequipTool()
				end
			end)
		end)

	syncTool()
end

--==================================================
-- MIRROR JUMP
--==================================================

local function mirrorJump()

	if not following then
		return
	end

	if followLocked then
		return
	end

	if not alive() then
		return
	end

	-- VERY IMPORTANT:
	-- Only allow the mirrored jump if WE are
	-- currently standing on the ground.
	if humanoid.FloorMaterial == Enum.Material.Air then
		return
	end

	if not canJump then
		return
	end

	if targetJumpDebounce then
		return
	end

	targetJumpDebounce = true
	canJump = false

	-- Use Jump property rather than repeatedly
	-- forcing the Humanoid state.
	humanoid.Jump = true

	jumpButton.Text = "WAIT..."
	jumpButton.BackgroundColor3 =
		Color3.fromRGB(90, 90, 90)

	-- Safety release. Actual landing below
	-- will also release canJump.
	task.delay(1.5, function()

		if targetJumpDebounce then
			targetJumpDebounce = false
		end
	end)
end

--==================================================
-- CONNECT TARGET
--==================================================

local function connectTarget()

	disconnectTarget()

	if not targetPlayer then
		return
	end

	if not updateTarget() then
		return
	end

	--==================================================
	-- TARGET JUMP EVENT
	--==================================================

	connections.TargetState =
		targetHumanoid.StateChanged:Connect(
			function(_, newState)

				if not following then
					return
				end

				-- This is the main jump detector.
				if newState ==
					Enum.HumanoidStateType.Jumping then

					mirrorJump()
				end
			end
		)

	--==================================================
	-- TARGET DEATH
	--==================================================

	connections.TargetDied =
		targetHumanoid.Died:Connect(function()

			following = false
			targetJumpDebounce = false

			disconnectTarget()

			followButton.Text = "FOLLOW"
			followButton.BackgroundColor3 =
				Color3.fromRGB(0, 170, 90)

			setStatus(
				"Target died. Following stopped.",
				Color3.fromRGB(255, 180, 80)
			)
		end)

	--==================================================
	-- TARGET RESPAWN
	--==================================================

	connections.TargetCharacter =
		targetPlayer.CharacterAdded:Connect(
			function(newCharacter)

				if not following then
					return
				end

				local newHumanoid =
					newCharacter:WaitForChild(
						"Humanoid",
						5
					)

				local newRoot =
					newCharacter:WaitForChild(
						"HumanoidRootPart",
						5
					)

				if not newHumanoid or not newRoot then
					return
				end

				if not following then
					return
				end

				-- Reconnect cleanly.
				connectTarget()
			end
		)

	connectToolSync()
end

--==================================================
-- FOLLOW MOVEMENT
--==================================================

local lastMove = nil

local function followTarget()

	if not following then
		return
	end

	if followLocked then
		return
	end

	if not alive() then
		return
	end

	if not updateTarget() then
		return
	end

	local targetPosition =
		targetRoot.Position
		- targetRoot.CFrame.LookVector * 4

	-- Only update MoveTo when necessary.
	if lastMove then
		if (targetPosition - lastMove).Magnitude < 0.2 then
			return
		end
	end

	lastMove = targetPosition

	humanoid:MoveTo(targetPosition)
end

connections.FollowLoop =
	RunService.Heartbeat:Connect(function()

		if following then
			followTarget()
		end
	end)

--==================================================
-- FOLLOW BUTTON
--==================================================

followButton.Activated:Connect(function()

	if followLocked then

		setStatus(
			"Locked. " ..
			(targetPlayer and
				targetPlayer.Name or
				"the target") ..
			" must touch you.",
			Color3.fromRGB(255, 180, 70)
		)

		return
	end

	-- Stop
	if following then

		following = false
		lastMove = nil

		disconnectTarget()

		followButton.Text = "FOLLOW"
		followButton.BackgroundColor3 =
			Color3.fromRGB(0, 170, 90)

		setStatus(
			"Not following",
			Color3.fromRGB(220, 220, 220)
		)

		return
	end

	local found =
		findPlayer(usernameBox.Text)

	if not found then

		setStatus(
			"Player not found.",
			Color3.fromRGB(255, 100, 100)
		)

		return
	end

	if found == player then

		setStatus(
			"You cannot follow yourself.",
			Color3.fromRGB(255, 100, 100)
		)

		return
	end

	targetPlayer = found
	following = true

	lastMove = nil
	targetJumpDebounce = false

	followButton.Text = "STOP"
	followButton.BackgroundColor3 =
		Color3.fromRGB(200, 60, 60)

	setStatus(
		"Following " ..
		targetPlayer.DisplayName ..
		" (@" ..
		targetPlayer.Name ..
		")",
		Color3.fromRGB(100, 255, 150)
	)

	connectTarget()
end)

--==================================================
-- MANUAL JUMP
--==================================================

jumpButton.Activated:Connect(function()

	if not alive() then
		return
	end

	if not canJump then
		return
	end

	if humanoid.FloorMaterial ==
		Enum.Material.Air then
		return
	end

	canJump = false

	jumpButton.Text = "WAIT..."
	jumpButton.BackgroundColor3 =
		Color3.fromRGB(90, 90, 90)

	humanoid.Jump = true
end)

--==================================================
-- OUR CHARACTER
--==================================================

local function setupCharacter(newCharacter)

	character = newCharacter

	humanoid =
		newCharacter:WaitForChild("Humanoid")

	rootPart =
		newCharacter:WaitForChild(
			"HumanoidRootPart"
		)

	canJump = true
	targetJumpDebounce = false
	lastMove = nil

	jumpButton.Text = "JUMP"
	jumpButton.BackgroundColor3 =
		Color3.fromRGB(0, 140, 255)

	--==================================================
	-- LANDING
	--==================================================

	disconnect("OurState")

	connections.OurState =
		humanoid.StateChanged:Connect(
			function(_, newState)

				if newState ==
					Enum.HumanoidStateType.Landed
					or newState ==
					Enum.HumanoidStateType.Running then

					canJump = true
					targetJumpDebounce = false

					jumpButton.Text = "JUMP"
					jumpButton.BackgroundColor3 =
						Color3.fromRGB(0, 140, 255)
				end
			end
		)

	--==================================================
	-- DEATH
	--==================================================

	disconnect("OurDeath")

	connections.OurDeath =
		humanoid.Died:Connect(function()

			-- Absolutely stop following before respawn.
			following = false
			lastMove = nil
			targetJumpDebounce = false

			disconnectTarget()

			-- Lock until target physically touches
			-- the new character.
			followLocked = true

			followButton.Text = "LOCKED"
			followButton.BackgroundColor3 =
				Color3.fromRGB(120, 80, 30)

			setStatus(
				"Dead. Respawn and let the target touch you.",
				Color3.fromRGB(255, 100, 100)
			)
		end)

	--==================================================
	-- TOUCH UNLOCK
	--==================================================

	for _, part in ipairs(
		newCharacter:GetDescendants()
	) do

		if part:IsA("BasePart") then

			part.Touched:Connect(function(hit)

				if not followLocked then
					return
				end

				if not targetPlayer then
					return
				end

				local targetModel =
					targetPlayer.Character

				if not targetModel then
					return
				end

				local hitModel =
					hit:FindFirstAncestorOfClass(
						"Model"
					)

				if hitModel == targetModel then

					followLocked = false
					following = true

					lastMove = nil
					targetJumpDebounce = false

					followButton.Text = "STOP"
					followButton.BackgroundColor3 =
						Color3.fromRGB(200, 60, 60)

					setStatus(
						"Unlocked! Following " ..
						targetPlayer.DisplayName,
						Color3.fromRGB(100, 255, 150)
					)

					connectTarget()
				end
			end)
		end
	end
end

